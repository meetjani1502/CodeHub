generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  password     String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  username     String?
  following    Follow[]     @relation("Following")
  followers    Follow[]     @relation("Followers")
  fork         Fork[]
  issues       Issue[]
  repositories Repository[]
  sessions     Session[]
  stars        Star[]
}

model Repository {
  id              Int           @id @default(autoincrement())
  name            String
  description     String?
  ownerId         Int
  createdAt       DateTime      @default(now())
  currentBranchId Int?
  branches        Branch[]      @relation("RepositoryBranches")
  commits         Commit[]
  files           File[]
  fork            Fork[]
  issues          Issue[]
  pullRequests    PullRequest[]
  currentBranch   Branch?       @relation("CurrentBranch", fields: [currentBranchId], references: [id])
  owner           User          @relation(fields: [ownerId], references: [id])
  stars           Star[]
}

model File {
  id           Int           @id @default(autoincrement())
  filename     String
  content      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  branchId     Int
  name         String
  repositoryId Int
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  repository   Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  versions     FileVersion[]
}

model Commit {
  id           Int           @id @default(autoincrement())
  message      String
  repositoryId Int
  createdAt    DateTime      @default(now())
  branchId     Int?
  branch       Branch?       @relation(fields: [branchId], references: [id])
  repository   Repository    @relation(fields: [repositoryId], references: [id])
  fileVersions FileVersion[]
}

model FileVersion {
  id        Int      @id @default(autoincrement())
  fileId    Int
  commitId  Int
  filename  String
  content   String
  createdAt DateTime @default(now())
  commit    Commit   @relation(fields: [commitId], references: [id])
  file      File     @relation(fields: [fileId], references: [id])
}

model Branch {
  id                  Int           @id @default(autoincrement())
  name                String
  repositoryId        Int
  repository          Repository    @relation("RepositoryBranches", fields: [repositoryId], references: [id], onDelete: Cascade)
  commits             Commit[]
  files               File[]
  sourcePullRequests  PullRequest[] @relation("sourceBranch")
  targetPullRequests  PullRequest[] @relation("targetBranch")
  currentRepositories Repository[]  @relation("CurrentBranch")
}

model PullRequest {
  id             Int        @id @default(autoincrement())
  title          String
  description    String?
  sourceBranchId Int
  targetBranchId Int
  status         String     @default("OPEN")
  createdAt      DateTime   @default(now())
  repositoryId   Int
  repository     Repository @relation(fields: [repositoryId], references: [id])
  sourceBranch   Branch     @relation("sourceBranch", fields: [sourceBranchId], references: [id])
  targetBranch   Branch     @relation("targetBranch", fields: [targetBranchId], references: [id])
}

model Star {
  id           Int        @id @default(autoincrement())
  userId       Int
  repositoryId Int
  createdAt    DateTime   @default(now())
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryId])
}

model Fork {
  id           Int        @id @default(autoincrement())
  repositoryId Int
  userId       Int
  createdAt    DateTime   @default(now())
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, userId])
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Issue {
  id           Int        @id @default(autoincrement())
  title        String
  description  String?
  status       String     @default("OPEN")
  repositoryId Int
  authorId     Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  author       User?      @relation(fields: [authorId], references: [id])
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model Session {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String
  device    String?
  ipAddress String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
